#!/bin/bash
# Pre-commit security scanning hook for urgdstudios.com
# Runs cfn-lint, Checkov, and Semgrep before allowing commits

set -euo pipefail

echo ""
echo "🔍 Running pre-commit security scans..."
echo "========================================"
echo ""

# Check if security tools are installed
if ! command -v cfn-lint &> /dev/null; then
    echo "⚠️  cfn-lint not found - install with: pip install cfn-lint"
    exit 1
fi

if ! command -v checkov &> /dev/null; then
    echo "⚠️  checkov not found - install with: pip install checkov"
    exit 1
fi

if ! command -v semgrep &> /dev/null; then
    echo "⚠️  semgrep not found - install with: pip install semgrep"
    exit 1
fi

# 1. Run cfn-lint
if [ -d "cloudformation" ]; then
    echo "1/3 Running cfn-lint..."
    if ! cfn-lint cloudformation/*.yaml --ignore-checks W3045,W2001; then
        echo ""
        echo "❌ cfn-lint failed"
        echo "Fix CloudFormation template errors before committing"
        exit 1
    fi
    echo "✅ cfn-lint passed"
    echo ""
fi

# 2. Run Checkov
if [ -d "cloudformation" ]; then
    echo "2/3 Running Checkov..."
    if ! checkov -f cloudformation/urgd-urgdstudios-com.yaml --framework cloudformation --quiet; then
        echo ""
        echo "❌ Checkov failed"
        echo "Fix infrastructure security issues before committing"
        exit 1
    fi
    echo "✅ Checkov passed"
    echo ""
fi

# 3. Run Semgrep
echo "3/3 Running Semgrep..."
if ! semgrep --config=auto . --quiet --error; then
    echo ""
    echo "❌ Semgrep failed"
    echo "Fix code security issues before committing"
    exit 1
fi
echo "✅ Semgrep passed"
echo ""

echo "========================================"
echo "✅ All security scans passed"
echo "========================================"
echo ""

exit 0
